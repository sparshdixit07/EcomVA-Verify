# ============ Core ============
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ============ Database ============
MONGODB_URI=mongodb://127.0.0.1:27017/ecomva_verify

# ============ JWT / Sessions ============
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_NAME=ev_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# ============ Password hashing ============
PASSWORD_HASH_DRIVER=argon2
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
BCRYPT_ROUNDS=12

# ============ Uploads ============
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,image/webp,application/pdf

# ============ Rate limits ============
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ============ Email (optional) ============
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@ecomva-verify.local

# ============ AI (optional) ============
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=